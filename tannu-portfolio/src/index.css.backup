
:root {
  /* VIBRANT FIELDBOOK PALETTE */
  --paper: #fff9f1;
  --ink: #1c2331;
  --muted: #464c5d;
  --electric: #4755f5;
  --coral: #ff8167;
  --lemon: #ffe06c;
  --mint: #b1e9d3;
  --lavender: #d7c4ff;
  --peach: #ffc3b4;

  --font-display: "Fraunces", Georgia, serif;
  --font-body: "DM Sans", Arial, sans-serif;
  --font-mono: "IBM Plex Mono", monospace;

  font-family: var(--font-body);
  color: var(--ink);
  background: var(--paper);
  color-scheme: light;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
}

::selection {
  color: var(--ink);
  background: var(--lemon);
}

a {
  color: inherit;
}

:focus-visible {
  outline: 3px solid var(--electric);
  outline-offset: 4px;
}

.skip-link {
  position: absolute;
  top: -100px;
  left: 1rem;
  z-index: 100;
  padding: 0.75rem 1rem;
  color: white;
  background: var(--ink);
}

.skip-link:focus {
  top: 1rem;
}

/* PAGE */

.site-shell {
  width: min(100%, 1500px);
  min-height: 100vh;
  margin-inline: auto;
  padding-inline: clamp(1.25rem, 5vw, 5rem);

  display: flex;
  flex-direction: column;
}

main {
  flex: 1;
}

main:focus {
  outline: none;
}

/* HEADER */

.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding-block: 1.5rem;
  border-bottom: 2px solid var(--ink);
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-family: var(--font-mono);
  font-size: 0.8rem;
  font-weight: 500;
  letter-spacing: 0.04em;
}

.brand-symbol {
  color: var(--electric);
  font-size: 1.7rem;
}

.edition {
  padding: 0.55rem 0.8rem;
  background: var(--lemon);
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 500;
  transform: rotate(-2deg);
}

/* HERO */

.introduction {
  position: relative;
  isolation: isolate;
  padding-top: clamp(3rem, 8vw, 7rem);
}

/* DECORATIVE STAR */

.introduction::before {
  content: "✳";
  position: absolute;
  top: 0;
  right: 5%;
  z-index: -1;
  font-size: clamp(5rem, 14vw, 12rem);
  color: var(--lemon);
  transform: rotate(-16deg);
  pointer-events: none;
  user-select: none;
}

.chapter-label,
.eyebrow,
.note-number,
.note-footer,
.principle span,
.site-footer {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.04em;
}

.chapter-label {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  color: var(--electric);
  font-weight: 500;
}

.chapter-dot {
  flex-shrink: 0;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--coral);
}

.intro-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(210px, 300px);
  align-items: center;
  gap: clamp(2rem, 5vw, 6rem);
  margin-top: 3rem;
}

.intro-content {
  min-width: 0;
}

.eyebrow {
  display: inline-block;
  padding: 0.55rem 0.8rem;
  margin: 0 0 1.5rem;
  color: var(--ink);
  background: var(--mint);
  font-weight: 500;
}

h1 {
  margin: 0;
  font-family: var(--font-display);
  font-size: clamp(3rem, 7.5vw, 8rem);
  font-weight: 400;
  line-height: 1.07;
  letter-spacing: -0.055em;
}

h1 em {
  color: var(--electric);
  font-weight: 400;
  background-image: linear-gradient(
    to top,
    var(--lemon) 24%,
    transparent 24%
  );
}

.accent {
  color: var(--coral);
}

.intro-description {
  max-width: 580px;
  margin-top: 2rem;
  color: var(--muted);
  font-size: clamp(1rem, 1.5vw, 1.2rem);
  line-height: 1.8;
}

/* INTERACTIVE CTA */

.explore-link {
  display: inline-flex;
  align-items: center;
  gap: 1.5rem;
  margin-top: 1rem;
  padding: 1rem 1.4rem;

  color: white;
  background: var(--ink);
  border: 2px solid var(--ink);
  box-shadow: 5px 5px 0 var(--coral);

  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;

  transition:
    transform 200ms ease,
    background-color 200ms ease;
}

.explore-link span {
  font-size: 1.4rem;
  transition: transform 200ms ease;
}

@media (hover: hover) and (pointer: fine) {
  .explore-link:hover {
    background: var(--electric);
    transform: translate(-2px, -4px);
  }

  .explore-link:hover span {
    transform: translate(3px, -3px);
  }
}

/* FIELD NOTE */

.field-note {
  position: relative;
  min-width: 0;
  padding: 1.75rem;

  background: var(--lavender);
  border: 2px solid var(--ink);
  box-shadow: 10px 10px 0 var(--coral);

  transform: rotate(-2deg);
  transition: transform 240ms ease;
}

.field-note::before {
  content: "✷";
  position: absolute;
  top: -1.1rem;
  right: 1rem;
  color: var(--electric);
  font-size: 3rem;
  pointer-events: none;
}

@media (hover: hover) and (pointer: fine) {
  .field-note:hover {
    transform: translateY(-9px) rotate(0deg);
  }
}

.note-number {
  color: var(--ink);
  font-weight: 500;
}

.note-rule {
  width: 55px;
  height: 4px;
  margin-block: 2rem;
  background: var(--coral);
}

.note-heading {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 2vw, 2rem);
  line-height: 1.25;
}

.note-description {
  color: var(--ink);
  font-size: 0.95rem;
  line-height: 1.7;
}

.note-footer {
  display: flex;
  justify-content: space-between;
  gap: 0.5rem;
  margin-top: 2rem;
  padding-top: 1rem;
  border-top: 1px solid var(--ink);
}

/* INTERACTIVE PRINCIPLE TILES */

#approach {
  scroll-margin-top: 2rem;
}

.principles {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
  margin-top: clamp(4rem, 8vw, 8rem);
}

.principle {
  min-width: 0;
  padding: 1.75rem;
  background: var(--mint);
  border: 2px solid var(--ink);
  box-shadow: 5px 5px 0 var(--ink);
  transition: transform 220ms ease;
}

.principle:nth-child(2) {
  background: var(--lemon);
}

.principle:nth-child(3) {
  background: var(--peach);
}

@media (hover: hover) and (pointer: fine) {
  .principle:hover {
    transform: translateY(-7px);
  }
}

.principle span {
  font-weight: 500;
}

.principle p {
  margin-bottom: 0;
  font-family: var(--font-display);
  font-size: clamp(1.25rem, 2vw, 1.65rem);
  line-height: 1.3;
}

/* FOOTER */

.site-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 5rem;
  padding-block: 2rem;
  border-top: 2px solid var(--ink);

  font-family: var(--font-mono);
  color: var(--muted);
}

/* TABLET */

@media (max-width: 900px) {
  .intro-grid {
    grid-template-columns: 1fr;
  }

  .field-note {
    max-width: 420px;
  }

  h1 {
    font-size: clamp(3.3rem, 9vw, 6rem);
  }
}

/* MOBILE */

@media (max-width: 600px) {
  .site-header {
    padding-block: 1.2rem;
  }

  .edition {
    display: none;
  }

  .introduction {
    padding-top: 3.5rem;
  }

  .intro-grid {
    margin-top: 2rem;
    gap: 3rem;
  }

  h1 {
    font-size: clamp(2.5rem, 10vw, 4rem);
    line-height: 1.1;
  }

  .intro-description {
    line-height: 1.7;
  }

  .field-note {
    width: calc(100% - 12px);
    transform: none;
  }

  .principles {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .site-footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 380px) {
  .site-shell {
    padding-inline: 1rem;
  }

  .brand {
    font-size: 0.7rem;
  }

  .eyebrow,
  .chapter-label {
    font-size: 0.62rem;
  }
}

/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
  }

  .explore-link:hover,
  .explore-link:hover span,
  .field-note:hover,
  .principle:hover {
    transform: none;
  }
}
